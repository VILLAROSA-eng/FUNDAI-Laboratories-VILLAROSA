        "class TicTacToeUI:\n",
        "    def __init__(self):\n",
        "        self.game = TicTacToeGame()\n",
        "\n",
        "        self.buttons = [\n",
        "            widgets.Button(\n",
        "                description=\" \",\n",
        "                layout=widgets.Layout(width=\"60px\", height=\"60px\")\n",
        "            )\n",
        "            for i in range(9)\n",
        "        ]\n",
